# Frontend configuration.
# Copy this file to .env (the project root) if it does not exist.

# Base URL used by src/api/httpApi.ts for every API call.
#
# Development (npm run dev): keep /api so Vite's proxy forwards requests to
# the FastAPI server on http://127.0.0.1:8000 (see vite.config.ts).
VITE_API_URL=/api

# Production, frontend and API on different origins: use the full API URL.
# This value is baked into the build, so rebuild after changing it.
# VITE_API_URL=https://loanflow-api.up.railway.app/api

# Production, FastAPI serves the built frontend (single origin): keep /api.
