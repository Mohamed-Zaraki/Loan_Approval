# Copy this file to .env to connect the frontend to the Python API.
# Leave VITE_API_URL undefined to keep running with browser demo data.

# Option A: use the Vite dev proxy (target configured in vite.config.ts)
VITE_API_URL=/api

# Option B: call the API directly (requires CORS on the backend)
# VITE_API_URL=http://127.0.0.1:8000/api
