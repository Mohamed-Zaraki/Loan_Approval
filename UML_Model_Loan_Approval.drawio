        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nclassDiagram\n    direction TB\n\n    class Applicant {\n        +int applicantId\n        +string fullName\n        +string idCardNumber\n        +int age\n        +string job\n        +bool hasCDI\n        +bool isMarried\n        +int numberOfChildren\n        +register()\n        +updateInformation()\n    }\n\n    class LoanApplication {\n        +int applicationId\n        +float monthlyIncome\n        +float totalDebt\n        +float savings\n        +bool incomeVerified\n        +float loanAmount\n        +int loanDuration\n        +string loanPurpose\n        +int missedPayments\n        +datetime createdAt\n        +submitApplication()\n        +validateApplication()\n    }\n\n    class LoanDecision {\n        +int decisionId\n        +string status\n        +string reason\n        +datetime decisionDate\n        +saveDecision()\n        +getDecision()\n    }\n\n    class LoanApprovalService {\n        +evaluateApplication()\n        +checkEligibility()\n        +calculateRepayment()\n        +calculateDebtRatio()\n        +generateDecision()\n    }\n\n    class BankManager {\n        +int managerId\n        +string name\n        +viewApplications()\n        +viewDecision()\n        +reviewApplication()\n    }\n\n    Applicant \&quot;1\&quot; --&gt; \&quot;0..*\&quot; LoanApplication : submits\n    LoanApplication \&quot;1\&quot; --&gt; \&quot;0..1\&quot; LoanDecision : receives\n    LoanApprovalService ..&gt; LoanApplication : evaluates\n    LoanApprovalService ..&gt; LoanDecision : generates\n    BankManager ..&gt; LoanApplication : reviews\n    BankManager ..&gt; LoanDecision : views\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="kuAV6wkQxlXG3oDf1cQE-1">
