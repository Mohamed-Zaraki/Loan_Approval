# LoanFlow backend configuration.
# Copy this file to backend/.env and fill in real values.
# Never commit backend/.env.

# --- MySQL connection -------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=loan_approval_db

# --- Manager authentication -------------------------------------------------
# Secret used to sign the manager session cookie (HS256).
# Must be at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=replace-with-at-least-32-random-characters

# Send the session cookie only over HTTPS. Keep false for local HTTP,
# set true on any public HTTPS deployment (Railway, Render, Fly, etc.).
COOKIE_SECURE=false

# Cookie SameSite policy: lax (same site), none (cross-site, requires
# COOKIE_SECURE=true), or strict.
COOKIE_SAMESITE=lax

# --- CORS -------------------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API.
# Only needed when the frontend is served from a different origin than the API.
# When FastAPI serves the built frontend itself (single origin), CORS is unused.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
